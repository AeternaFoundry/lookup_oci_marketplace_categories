variable "marketplace_categories_lookup" {
  description = <<EOT
Map of marketplace_categories_lookup, attributes below
Optional:
    - compartment_id
    - filter (block):
        - name (required)
        - regex (optional)
        - values (required)
EOT

  type = map(object({
    compartment_id = optional(string)
    filter = optional(list(object({
      name   = string
      regex  = optional(bool)
      values = list(string)
    })))
  }))
}

